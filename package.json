{
  "name": "body-metrics-formulas",
  "version": "1.1.1",
  "description": "Reference implementations of body-composition metrics (BRI, RFM, waist-to-height ratio, ABSI, FFMI, lean body mass) checked against their source papers, plus US population percentiles from NHANES 2021-2023.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abdelilah-ka/body-metrics-formulas.git"
  },
  "homepage": "https://thebodyindex.com",
  "keywords": [
    "body-roundness-index",
    "bri",
    "relative-fat-mass",
    "rfm",
    "waist-to-height-ratio",
    "whtr",
    "a-body-shape-index",
    "absi",
    "ffmi",
    "body-composition",
    "anthropometry",
    "bmi",
    "body-fat",
    "waist",
    "health",
    "calculator",
    "nhanes",
    "percentile",
    "typescript"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm test && npm run build"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "bugs": {
    "url": "https://github.com/abdelilah-ka/body-metrics-formulas/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
